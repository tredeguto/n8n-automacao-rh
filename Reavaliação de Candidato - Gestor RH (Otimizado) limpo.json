    {
      "parameters": {
        "jsCode": "const DATA_ENTREVISTA = \"2026-09-21\";\nconst SLOTS = [\n  { start: \"10:00:00\", end: \"10:30:00\" },\n  { start: \"11:00:00\", end: \"11:30:00\" },\n  { start: \"13:00:00\", end: \"13:30:00\" },\n  { start: \"14:00:00\", end: \"14:30:00\" },\n  { start: \"15:00:00\", end: \"15:30:00\" }\n];\n\nconst index = typeof $position === 'number' ? $position : 0;\nconst slot = SLOTS[index % SLOTS.length];\n\nreturn {\n  json: {\n    ...$input.item.json,\n    data_inicio_entrevista: `${DATA_ENTREVISTA}T${slot.start}`,\n    data_fim_entrevista: `${DATA_ENTREVISTA}T${slot.end}`\n  }\n};"
      },
      "id": "cbccd735-e58b-42e7-8385-7f5dfe787e58",
      "name": "Config Agenda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -96
      ]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "SEU_EMAIL@DOMINIO.COM",
          "mode": "id"
        },
        "start": "={{ $json.data_inicio_entrevista }}",
        "end": "={{ $json.data_fim_entrevista }}",
        "additionalFields": {
          "summary": "={{ 'Entrevista Reavaliada - ' + $json.Candidato }}"
        }
      },
